# ==============================================================================
# Cấu hình môi trường Production cho Frappe LMS trên Azure VM
# Hãy đổi tên file này thành .env trước khi chạy docker compose
# ==============================================================================

# Tên miền chính thức của bạn (ví dụ: lms.example.com hoặc lms.localhost)
SITE_NAME=lms.yourdomain.com

# Mật khẩu tài khoản Administrator (Mặc định trong môi trường dev là admin)
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Mật khẩu MariaDB Root (Mặc định trong môi trường dev là 123)
MARIADB_ROOT_PASSWORD=YourStrongDbPassword123!
